#!/bin/bash
#PBS -N a2d2e_nonadd
#PBS -o logs/
#PBS -e logs/
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=4:00:00
#PBS -J 0-279%100

# Grid: 7 envs x 5 methods x 4 models x 2 rhos = 280 jobs
ENVS=(g1 g2 g3 g4 g5 g6 g7)
METHODS=(pd ale a2d2e_goldilocks dale m)
MODELS=(knn nn gp rf)
RHOS=(0.7 0.9)

source ~/.bashrc
micromamba activate healthkit

N_ENVS=${#ENVS[@]}
N_METHODS=${#METHODS[@]}
N_MODELS=${#MODELS[@]}
N_RHOS=${#RHOS[@]}

idx=$PBS_ARRAY_INDEX

rho_idx=$(($idx    % $N_RHOS));    idx=$(($idx    / $N_RHOS))
model_idx=$(($idx  % $N_MODELS));  idx=$(($idx    / $N_MODELS))
method_idx=$(($idx % $N_METHODS)); idx=$(($idx    / $N_METHODS))
env_idx=$(($idx    % $N_ENVS))

ENV=${ENVS[$env_idx]}
METHOD=${METHODS[$method_idx]}
MODEL=${MODELS[$model_idx]}
RHO=${RHOS[$rho_idx]}

declare -A D_MAP
D_MAP[g1]=2; D_MAP[g2]=4; D_MAP[g3]=4
D_MAP[g4]=3; D_MAP[g5]=4; D_MAP[g6]=4; D_MAP[g7]=8

D=${D_MAP[$ENV]}
N_TRAIN=$((50 * D))

N_REPS=30
K=40
DELTA=0.025
N_GRID=100
NOISE=0.3
SEED=0

mkdir -p logs results_nonadditive
cd $PBS_O_WORKDIR

echo "=============================="
echo "PBS_ARRAY_INDEX : $PBS_ARRAY_INDEX"
echo "env             : $ENV"
echo "method          : $METHOD"
echo "model           : $MODEL"
echo "rho             : $RHO"
echo "D               : $D"
echo "N_TRAIN         : $N_TRAIN"
echo "node            : $(hostname)"
echo "=============================="

python experiments/appendix_d2/run.py \
    --env        "$ENV"              \
    --method     "$METHOD"           \
    --model      "$MODEL"            \
    --rho        $RHO                \
    --n-train    $N_TRAIN            \
    --n-reps     $N_REPS             \
    --n-grid     $N_GRID             \
    --K          $K                  \
    --delta      $DELTA              \
    --delta-grid 0.005 0.01 0.0125 0.025 0.05 0.1 \
    --noise-frac $NOISE              \
    --seed       $SEED               \
    --param-dir  param_nonadditive   \
    --outdir     results_nonadditive \
    --save-curves                    \
    --verbose

echo "END: $(date)"
