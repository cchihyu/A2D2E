#!/bin/bash
#PBS -N a2d2e_sweep
#PBS -o logs/
#PBS -e logs/
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=8:00:00
#PBS -J 0-419%100

# Grid: 7 envs x 5 methods x 1 model x 3 noises x 4 dependences = 420 jobs
ENVS=(f0 f1 f2 f3 f4 f5 f6)
METHODS=(pd m ale a2d2e dale)
MODELS=(knn)
NOISE_LEVELS=(0.1 0.3 0.5)
DEPENDENCES=(independent low high veryhigh)

source ~/.bashrc
micromamba activate healthkit

N_ENVS=${#ENVS[@]}
N_METHODS=${#METHODS[@]}
N_MODELS=${#MODELS[@]}
N_NOISE=${#NOISE_LEVELS[@]}
N_DEP=${#DEPENDENCES[@]}

idx=$PBS_ARRAY_INDEX

dep_idx=$(($idx % $N_DEP));      idx=$(($idx / $N_DEP))
noise_idx=$(($idx % $N_NOISE));  idx=$(($idx / $N_NOISE))
model_idx=$(($idx % $N_MODELS)); idx=$(($idx / $N_MODELS))
method_idx=$(($idx % $N_METHODS)); idx=$(($idx / $N_METHODS))
env_idx=$(($idx % $N_ENVS))

ENV=${ENVS[$env_idx]}
METHOD=${METHODS[$method_idx]}
MODEL=${MODELS[$model_idx]}
NOISE=${NOISE_LEVELS[$noise_idx]}
DEP=${DEPENDENCES[$dep_idx]}

declare -A D_MAP
D_MAP[f0]=3; D_MAP[f1]=2; D_MAP[f2]=4; D_MAP[f3]=4
D_MAP[f4]=4; D_MAP[f5]=8; D_MAP[f6]=10

D=${D_MAP[$ENV]}
N_TRAIN=$((100 * D))

N_REPS=100
K=40
DELTA=0.025
N_GRID=100
SEED=0

mkdir -p logs results_new
cd $PBS_O_WORKDIR

echo "=============================="
echo "PBS_ARRAY_INDEX : $PBS_ARRAY_INDEX"
echo "env             : $ENV"
echo "method          : $METHOD"
echo "model           : $MODEL"
echo "noise           : $NOISE"
echo "dep             : $DEP"
echo "D               : $D"
echo "N_TRAIN         : $N_TRAIN"
echo "node            : $(hostname)"
echo "=============================="

python experiments/main_comparison/run.py \
    --env        "$ENV"    \
    --method     "$METHOD" \
    --model      "$MODEL"  \
    --dependence "$DEP"    \
    --n-train    $N_TRAIN  \
    --n-reps     $N_REPS   \
    --n-grid     $N_GRID   \
    --K          $K        \
    --delta      $DELTA    \
    --noise-frac $NOISE    \
    --seed       $SEED     \
    --param-dir  model_params     \
    --outdir     results   \
    --save-curves          \
    --verbose

echo "END: $(date)"
